# =============================================
# ENCUESTAAPP — Variables de Entorno (EJEMPLO)
# =============================================
# NUNCA commites el archivo .env con valores reales
# Copia este archivo como .env y completa los valores
# =============================================

# ── SERVIDOR ──────────────────────────────────
NODE_ENV=development
PORT=3001
API_VERSION=v1

# ── BASE DE DATOS POSTGRESQL ──────────────────
# Formato: postgresql://usuario:contraseña@host:puerto/basedatos
DATABASE_URL=postgresql://admin:TuNuevaClaveSegura@localhost:5432/encuestaDb
DATABASE_SSL=false
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=10

# ── AUTENTICACIÓN JWT ─────────────────────────
# Generar con: openssl genrsa -out private.key 2048
# y: openssl rsa -in private.key -pubout -out public.key
JWT_PRIVATE_KEY_PATH=./keys/private.key
JWT_PUBLIC_KEY_PATH=./keys/public.key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Alternativa con secret simple para desarrollo:
JWT_SECRET=CAMBIA_ESTE_SECRET_POR_ALGO_MUY_LARGO_Y_ALEATORIO_EN_PRODUCCION

# ── CORS ──────────────────────────────────────
# Dominio del frontend (sin barra final)
CORS_ORIGIN=http://localhost:5173
# En producción: https://tu-dominio.vercel.app

# ── SESIONES Y COOKIES ────────────────────────
COOKIE_SECRET=CAMBIA_ESTE_SECRET_POR_ALGO_MUY_LARGO_Y_ALEATORIO_EN_PRODUCCION
COOKIE_SECURE=false
# En producción COOKIE_SECURE=true

# ── RATE LIMITING ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ── LOGS ──────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ── SALUD DEL SISTEMA ─────────────────────────
HEALTH_CHECK_PATH=/api/health

# ── REPORTES ──────────────────────────────────
REPORTS_TEMP_DIR=./tmp/reports
MAX_EXPORT_ROWS=50000

# ── ENCUESTADORES ─────────────────────────────
ENUMERATOR_CODE_PREFIX=ENC

# ── ADMINISTRADOR INICIAL (solo para seeds) ───
SEED_ADMIN_USERNAME=Mveliz
SEED_ADMIN_EMAIL=manuelcotonio9@gmail.com
SEED_ADMIN_FULL_NAME =Manuel Veliz
SEED_ADMIN_PASSWORD=App-wQnwf2CLP8j-AH2gMRuHe9Z0iqjzxWFE