{
  "name": "encuestaapp-backend",
  "version": "1.0.0",
  "description": "Backend API para el Sistema de Encuestas Electorales y Municipales de Guatemala",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run migrate",
    "build": "tsc",
    "start": "node dist/server.js",
    "deploy": "npm run migrate && npm run build",
    "migrate": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir database/migrations up",
    "migrate:down": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir database/migrations down",
    "migrate:create": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir database/migrations create",
    "seed": "tsx database/seeds/run.ts",
    "seed:admin": "tsx src/database/seedAdmin.ts",
    "reset:admin-password": "tsx src/database/resetAdminPassword.ts",
    "unlock:admin": "tsx src/database/unlockAdmin.ts",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "dotenv": "^18.0.9",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-pg-migrate": "^7.5.2",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "uuid": "^10.0.0",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/pdfkit": "^0.13.7",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "testMatch": ["**/*.test.ts"]
  }
}
